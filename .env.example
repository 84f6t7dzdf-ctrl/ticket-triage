# Where tickets are read from. Swap this for the exam database.
DATABASE_URL=postgresql+psycopg://triage:triage@localhost:5432/tickets

# Where triage results are written. Defaults to DATABASE_URL if unset,
# so a read-only source database can be paired with a separate results DB.
# RESULTS_DATABASE_URL=postgresql+psycopg://triage:triage@localhost:5432/tickets

# Which column mapping to use (file in config/).
SOURCE_CONFIG=config/source.yaml

# Used from step 3 onwards.
ANTHROPIC_API_KEY=
